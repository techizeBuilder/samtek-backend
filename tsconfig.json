{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "rootDir": "../",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "exclude": [
    "dist",
    "node_modules",
    "db.ts",
    "storage.ts",
    "storage.js",
    "routes.ts"
  ]
}